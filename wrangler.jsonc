// Cloudflare Workers 配置（静态资源 + API）
// 文档：https://developers.cloudflare.com/workers/static-assets/
//
// ⚠️ name 必须与 Cloudflare 上的 Worker 项目名完全一致，
//    否则 wrangler deploy 会部署到另一个（新建的）Worker 上。
{
  "name": "onlin-website",
  "compatibility_date": "2026-11-12",
  "main": "src/index.js",
  "upload_source_maps": true,

  "assets": {
    // 纯静态文件都在 public/，URL 路径与目录结构一一对应
    "directory": "./public",
    // 让 Worker 脚本可以用 env.ASSETS.fetch() 兜底
    "binding": "ASSETS",
    // 找不到文件时返回 public/404.html
    "not_found_handling": "404-page",
    // 只有 /api/* 先经过 Worker，其余静态资源由边缘节点直出
    "run_worker_first": ["/api/*"]
  },

  // D1 数据库绑定：排行榜成绩走这里。
  // 注意：Workers 以配置文件为准，Dashboard 里手动加的绑定会在下次部署时被覆盖。
  // binding 必须是 DB —— src/scores.js 读的是 env.DB，改名会导致接口返回 503。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "neon-combo",
      "database_id": "ebc0b10e-fd9f-4cba-a8ae-0823f8e2b5d3"
    }
  ],

  // 定时任务：每周清空排行榜（src/index.js 的 scheduled → resetScores）
  // cron 每小时的 0 分跑一次，但是否真的清空由代码判断：
  // 只有「美东时间周一 00:00 这一小时」才执行。
  // 为什么不直接写一个 UTC 的周一凌晨：北美有夏令时，写死 04:00 UTC 会在冬天
  // 变成周日 23:00，写死 05:00 UTC 又会在夏天变成 01:00，页面承诺的
  // 「每周一 00:00（美东）」就有一半时间是错的。交给 Intl 判断就不会偏。
  // 想改清空时间：改 src/index.js 的 isResetMoment()，cron 不用动。
  "triggers": {
    "crons": ["0 * * * *"]
  },

  "observability": {
    "enabled": true
  }
}
